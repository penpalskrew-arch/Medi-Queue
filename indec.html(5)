<script>
// FIREBASE - same config, but 100% clinic isolated
const firebaseConfig = { apiKey: "AIzaSyDJ4GnTbOQYonUYDmDRYPoK-RUQsP3f7Jw", authDomain: "flow-sync-77f0b.firebaseapp.com", databaseURL: "https://flow-sync-77f0b-default-rtdb.asia-southeast1.firebasedatabase.app", projectId: "flow-sync-77f0b" };
firebase.initializeApp(firebaseConfig);
const db = firebase.database();
const ADMIN_PIN = "6026";
let clinicId = null, clinicData = null, currentPatient = null, selectedType = "online", pinMode = "", pinBuffer = "", emergencyActive = false;

function showToast(msg) { let t = document.getElementById("toast"); t.textContent = msg; t.classList.add("show"); setTimeout(() => t.classList.remove("show"), 2500); }
function goBack() { document.querySelectorAll(".screen").forEach(s => s.classList.remove("active")); document.getElementById("homeScreen").classList.add("active"); refreshHomePreview(); }
function goToScreen(id) { document.querySelectorAll(".screen").forEach(s => s.classList.remove("active")); document.getElementById(id).classList.add("active"); }
function closeModal(id) { document.getElementById(id).classList.remove("open"); }

// Routing & clinic isolation
const urlParams = new URLSearchParams(window.location.search);
clinicId = urlParams.get("c");
async function init() {
  if (!clinicId) { document.getElementById("adminPortal").style.display = "flex"; document.getElementById("homeClinicName").innerHTML = "Admin Dashboard"; document.getElementById("loader").style.display = "none"; loadAllClinics(); return; }
  try {
    let snap = await db.ref(`clinics/${clinicId}`).get();
    if (!snap.exists()) { document.getElementById("loaderMsg").innerText = "Clinic not found"; setTimeout(()=>document.getElementById("loader").style.display="none",2000); return; }
    clinicData = snap.val();
    document.getElementById("homeClinicName").innerHTML = clinicData.name;
    if (clinicData.startTime || clinicData.stopTime) document.getElementById("clinicHoursDisplay").innerHTML = `🕐 ${clinicData.startTime||'--:--'} - ${clinicData.stopTime||'--:--'}`;
    document.getElementById("loader").style.display = "none";
    let savedToken = localStorage.getItem(`token_${clinicId}`);
    if (savedToken) { currentPatient = { token: parseInt(savedToken) }; goToScreen("statusScreen"); loadPatientStatus(); }
    refreshHomePreview();
    startRealtimeUpdates();
  } catch(e) { document.getElementById("loaderMsg").innerText = "Connection error"; setTimeout(()=>document.getElementById("loader").style.display="none",2000); }
}

async function refreshHomePreview() { if (!clinicId) return; let snap = await db.ref(`queues/${clinicId}`).get(); let online=0, walkin=0, curTok=null; snap.forEach(c=>{ let p=c.val(); if(p.status!=="done"){ if(p.type==="online") online++; else if(p.type==="walkin") walkin++; if(p.status==="with-doctor") curTok=p.token; } }); document.getElementById("previewOnline").innerHTML = online; document.getElementById("previewWalkin").innerHTML = walkin; document.getElementById("currentTokenDisplay").innerHTML = curTok ? `#${curTok}` : "—"; document.getElementById("queueTimestamp").innerHTML = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}); }
function startRealtimeUpdates() { if(!clinicId) return; db.ref(`queues/${clinicId}`).on("value",()=>{ if(document.getElementById("homeScreen").classList.contains("active")) refreshHomePreview(); if(document.getElementById("doctorScreen").classList.contains("active")) loadDoctorQueue(); if(document.getElementById("receptionScreen").classList.contains("active")) loadReceptionQueue(); }); db.ref(`clinics/${clinicId}`).on("value",(s)=>{ if(s.exists()){ clinicData=s.val(); if(document.getElementById("doctorScreen").classList.contains("active") && clinicData.delay) { document.getElementById("docDelayBanner").style.display="block"; document.getElementById("docDelayText").innerHTML=`⏰ Running ${clinicData.delay} min behind`; } else if(document.getElementById("doctorScreen").classList.contains("active")) document.getElementById("docDelayBanner").style.display="none"; if(clinicData.globalAnnouncement) { document.getElementById("globalAnnouncement").innerHTML=clinicData.globalAnnouncement; document.getElementById("globalAnnouncement").style.display="block"; } } }); }

async function processCheckin() { let name=document.getElementById("checkinName").value.trim(), phone=document.getElementById("checkinPhone").value.trim(); if(!name){ showToast("Enter name"); return; } let btn=document.getElementById("checkinBtn"); btn.disabled=true; btn.innerText="Processing..."; try { let counterRef=db.ref(`counters/${clinicId}`); let token; await counterRef.transaction(cur=>{ token=(cur||0)+1; return token; }); let queueSnap=await db.ref(`queues/${clinicId}`).get(); let hasDoctor=false; queueSnap.forEach(c=>{ if(c.val().status==="with-doctor") hasDoctor=true; }); let status=!hasDoctor?"next":"waiting"; await db.ref(`queues/${clinicId}`).push({ name, phone, token, type:selectedType, status, createdAt:Date.now(), visits:1 }); localStorage.setItem(`token_${clinicId}`, token); currentPatient={ token, name }; document.getElementById("statusName").innerHTML=name; document.getElementById("statusToken").innerHTML=`#${token}`; showToast(`Token #${token} assigned`); goToScreen("statusScreen"); loadPatientStatus(); refreshHomePreview(); } catch(e){ showToast("Error: "+e.message); } finally{ btn.disabled=false; btn.innerText="Check In →"; } }

function loadPatientStatus() { if(!currentPatient||!clinicId) return; db.ref(`queues/${clinicId}`).on("value",(snap)=>{ let all=[]; snap.forEach(c=>all.push({...c.val(),key:c.key})); let myData=all.find(p=>p.token===currentPatient.token); if(!myData) return; let waiting=all.filter(p=>p.status==="waiting"||p.status==="next").sort((a,b)=>a.token-b.token); let pos=waiting.findIndex(p=>p.token===currentPatient.token)+1; if(myData.status==="with-doctor"){ document.getElementById("statusPosition").innerHTML="→"; document.getElementById("statusMessage").innerHTML="It's your turn! Please go in now."; } else if(myData.status==="done"){ document.getElementById("statusPosition").innerHTML="✓"; document.getElementById("statusMessage").innerHTML="Visit complete. Thank you!"; if(myData.note) { document.getElementById("doctorNote").style.display="block"; document.getElementById("doctorNoteText").innerHTML=myData.note; } if(clinicData?.reviewLink) document.getElementById("reviewBtn").style.display="block"; localStorage.removeItem(`token_${clinicId}`); if(clinicData?.loyaltyEnabled && (myData.visits||1)%4===0) showLoyaltyReward(myData.visits||1, myData.phone); } else if(pos===1){ document.getElementById("statusPosition").innerHTML="1st"; document.getElementById("statusMessage").innerHTML="You're next! Please be ready."; } else { document.getElementById("statusPosition").innerHTML=`${pos}`; document.getElementById("statusMessage").innerHTML=`${pos-1} person(s) ahead`; } if(clinicData?.delay) { document.getElementById("statusDelay").style.display="block"; document.getElementById("statusDelay").innerHTML=`⏰ Clinic is ${clinicData.delay} min behind`; } }); }

function showLoyaltyReward(visits, phone){ let code="GIFT"+Math.random().toString(36).slice(2,8).toUpperCase(); document.getElementById("loyaltyCard").style.display="block"; document.getElementById("stampCount").innerHTML=visits%4; document.getElementById("giftCodeBox").style.display="block"; document.getElementById("giftCode").innerHTML=code; db.ref(`gifts/${clinicId}/${code}`).set({ issuedTo:phone, issuedAt:Date.now(), used:false }); }
function shareGiftCode(){ let code=document.getElementById("giftCode").innerHTML; window.open(`https://wa.me/?text=${encodeURIComponent(`🎁 Free gift for you! Use code: ${code} at ${clinicData?.name}`)}`); }
function openReview(){ if(clinicData?.reviewLink) window.open(clinicData.reviewLink); }

// Staff functions (Doctor + Reception share same core logic)
async function callNextPatient() { if(!clinicId) return; let queueRef=db.ref(`queues/${clinicId}`); await queueRef.transaction(data=>{ if(!data) return; let entries=Object.entries(data).map(([k,v])=>({...v,key:k})); let current=entries.find(e=>e.status==="with-doctor"); if(current) data[current.key].status="done"; let waiting=entries.filter(e=>e.status==="waiting"||e.status==="next").sort((a,b)=>a.token-b.token); if(emergencyActive && waiting.length){ let emergencyEntry=waiting.find(e=>e.emergency); if(emergencyEntry) data[emergencyEntry.key].status="with-doctor"; else if(waiting[0]) data[waiting[0].key].status="with-doctor"; } else if(waiting[0]) data[waiting[0].key].status="with-doctor"; return data; }); showToast("Next patient called"); }
async function moveBackPatient() { let snap=await db.ref(`queues/${clinicId}`).get(); let current=null, currentKey=null; snap.forEach(c=>{ if(c.val().status==="with-doctor"){ current=c.val(); currentKey=c.key; } }); if(currentKey){ let waiting=[]; snap.forEach(c=>{ let p=c.val(); if(p.status==="waiting" && p.key!==currentKey) waiting.push({...p,key:c.key}); }); waiting.sort((a,b)=>a.token-b.token); let pos3=waiting[2]||waiting[waiting.length-1]; if(pos3){ let newToken=pos3.token+0.5; await db.ref(`queues/${clinicId}/${currentKey}`).update({ status:"waiting", token:newToken, wasSkipped:true }); showToast(`${current.name} moved 3 positions back`); } else showToast("Not enough patients to move back"); } else showToast("No active patient"); }
function toggleEmergencyMode(){ emergencyActive=!emergencyActive; document.getElementById("emergencyToggleBtn").style.background=emergencyActive?"var(--danger)":"var(--btn-emergency)"; showToast(emergencyActive?"Emergency mode ON - Next patient jumps":"Emergency mode OFF"); }
async function addDelay(m){ await db.ref(`clinics/${clinicId}/delay`).set((clinicData?.delay||0)+m); showToast(`+${m} min delay`); }
async function togglePause(){ let newState=!clinicData?.paused; await db.ref(`clinics/${clinicId}`).update({paused:newState, pauseMsg:newState?"Queue paused - Back shortly":""}); showToast(newState?"Queue paused":"Queue resumed"); }
function openBroadcastModal(){ document.getElementById("broadcastModal").classList.add("open"); }
async function sendBroadcast(){ let msg=document.getElementById("broadcastMsg").value; await db.ref(`clinics/${clinicId}/globalAnnouncement`).set(msg); closeModal("broadcastModal"); showToast("Broadcast sent"); }
async function clearQueue(){ if(confirm("Clear entire queue?")){ await db.ref(`queues/${clinicId}`).remove(); await db.ref(`counters/${clinicId}`).set(0); showToast("Queue cleared"); } }
function openAddPatientModal(){ let name=prompt("Patient name:"); if(name) addManualPatient(name); }
async function addManualPatient(name){ let counterRef=db.ref(`counters/${clinicId}`); let token; await counterRef.transaction(cur=>{ token=(cur||0)+1; return token; }); await db.ref(`queues/${clinicId}`).push({ name, token, type:"walkin", status:"waiting", addedByStaff:true, createdAt:Date.now() }); showToast(`${name} added with token #${token}`); }
function openVisitorModal(){ document.getElementById("visitorModal").classList.add("open"); }
async function addVisitor(){ let name=document.getElementById("visitorName").value.trim(), purpose=document.getElementById("visitorPurpose").value.trim(); if(!name) return; await db.ref(`queues/${clinicId}`).push({ name, purpose, type:"visitor", status:"waiting", createdAt:Date.now() }); closeModal("visitorModal"); showToast(`${name} added as visitor`); loadDoctorQueue(); }
async function loadDoctorQueue(){ let snap=await db.ref(`queues/${clinicId}`).get(); let patients=[], visitors=[]; snap.forEach(c=>{ let p=c.val(); if(p.type==="visitor") visitors.push(p); else if(p.status!=="done") patients.push(p); }); let current=patients.find(p=>p.status==="with-doctor"); let waiting=patients.filter(p=>p.status==="waiting"||p.status==="next").sort((a,b)=>a.token-b.token); document.getElementById("docCurName").innerHTML=current?current.name:"—"; document.getElementById("docCurMeta").innerHTML=current?`Token #${current.token} · ${current.type}`:"No patient"; let queueHtml=waiting.map(p=>`<div class="queue-item ${p.emergency?'emergency':''}" onclick="selectEmergency('${p.key}')"><div class="token-badge ${p.type==='walkin'?'walkin':''}">${p.token}</div><div><strong>${p.name}</strong><div style="font-size:11px;">${p.type} · ${p.time||''}</div></div><div style="margin-left:auto;">${p.emergency?'🚨':''}</div></div>`).join(""); document.getElementById("docQueueList").innerHTML=queueHtml||'<div class="empty-state">Queue empty</div>'; let visitorHtml=visitors.map(v=>`<div class="queue-item visitor"><div class="token-badge">👔</div><div><strong>${v.name}</strong><div style="font-size:11px;">${v.purpose||"Visitor"}</div></div></div>`).join(""); document.getElementById("visitorList").innerHTML=visitorHtml; }
async function loadReceptionQueue(){ let snap=await db.ref(`queues/${clinicId}`).get(); let online=0,walkin=0,total=0,needAssist=0,patients=[]; snap.forEach(c=>{ let p=c.val(); if(p.status!=="done" && p.type!=="visitor"){ total++; if(p.type==="online") online++; else walkin++; if(!p.phone) needAssist++; patients.push(p); } }); document.getElementById("recOnline").innerHTML=online; document.getElementById("recWalkin").innerHTML=walkin; document.getElementById("recTotal").innerHTML=total; document.getElementById("recNeedAssist").innerHTML=needAssist; patients.sort((a,b)=>a.token-b.token); let html=patients.map(p=>`<div class="queue-item ${p.emergency?'emergency':''}" onclick="selectEmergency('${p.key}')"><div class="token-badge ${p.type==='walkin'?'walkin':''}">${p.token}</div><div><strong>${p.name}</strong><div style="font-size:11px;">${p.type} · ${p.status}</div></div><div style="margin-left:auto;">${p.emergency?'🚨':''}${!p.phone?'📵':''}</div></div>`).join(""); document.getElementById("recQueueList").innerHTML=html||'<div class="empty-state">Queue empty</div>'; }
function selectEmergency(key){ if(confirm("Mark as emergency? This patient jumps to front.")) db.ref(`queues/${clinicId}/${key}`).update({ emergency:true, status:"next", token:0.5 }); }
function goToCheckin(){ selectedType="online"; document.getElementById("onlineTypeOpt").classList.add("selected"); document.getElementById("walkinTypeOpt").classList.remove("selected"); document.getElementById("checkinName").value=""; document.getElementById("checkinPhone").value=""; goToScreen("checkinScreen"); }
function selectCheckinType(type){ selectedType=type; document.getElementById("onlineTypeOpt").classList.toggle("selected",type==="online"); document.getElementById("walkinTypeOpt").classList.toggle("selected",type==="walkin"); }
// Settings & Admin
function openSettingsModal(){ document.getElementById("setStart").value=clinicData?.startTime||""; document.getElementById("setStop").value=clinicData?.stopTime||""; document.getElementById("setMax").value=clinicData?.maxPatients||0; document.getElementById("setGrace").value=clinicData?.gracePeriod||10; let loy=clinicData?.loyaltyEnabled||false; document.getElementById("setLoyToggle").classList.toggle("active",loy); document.getElementById("setLoyRow").style.display=loy?"block":"none"; document.getElementById("setReward").value=clinicData?.rewardDesc||""; document.getElementById("settingsModal").classList.add("open"); }
function toggleSetLoy(){ let tog=document.getElementById("setLoyToggle"); tog.classList.toggle("active"); document.getElementById("setLoyRow").style.display=tog.classList.contains("active")?"block":"none"; }
async function saveClinicSettings(){ await db.ref(`clinics/${clinicId}`).update({ startTime:document.getElementById("setStart").value, stopTime:document.getElementById("setStop").value, maxPatients:parseInt(document.getElementById("setMax").value)||0, gracePeriod:parseInt(document.getElementById("setGrace").value)||10, loyaltyEnabled:document.getElementById("setLoyToggle").classList.contains("active"), rewardDesc:document.getElementById("setReward").value }); closeModal("settingsModal"); showToast("Settings saved"); }
function toggleNcLoy(){ let tog=document.getElementById("ncLoyToggle"); tog.classList.toggle("active"); document.getElementById("ncLoyRow").style.display=tog.classList.contains("active")?"block":"none"; }
async function createClinic(){ let name=document.getElementById("ncName").value.trim(), dpin=document.getElementById("ncDpin").value.trim(), rpin=document.getElementById("ncRpin").value.trim(); if(!name||!dpin||!rpin){ showToast("Fill all fields"); return; } let id=name.toLowerCase().replace(/[^a-z0-9]/g,'-')+"-"+Math.random().toString(36).slice(2,6); await db.ref(`clinics/${id}`).set({ name, doctorPin:dpin, receptionPin:rpin, reviewLink:document.getElementById("ncReview").value, startTime:document.getElementById("ncStart").value, stopTime:document.getElementById("ncStop").value, maxPatients:parseInt(document.getElementById("ncMax").value)||0, loyaltyEnabled:document.getElementById("ncLoyToggle").classList.contains("active"), rewardDesc:document.getElementById("ncReward").value, delay:0, paused:false, createdAt:Date.now() }); let link=`${location.origin}${location.pathname}?c=${id}`; showToast("Clinic created!"); prompt("Copy clinic link:", link); loadAllClinics(); }
async function loadAllClinics(){ let snap=await db.ref("clinics").get(); if(!snap.exists()){ document.getElementById("clinicList").innerHTML='<div class="empty-state">No clinics</div>'; return; } let html=""; snap.forEach(c=>{ let data=c.val(); let link=`${location.origin}${location.pathname}?c=${c.key}`; html+=`<div class="card"><strong>${data.name}</strong><br><small style="color:var(--text-muted);word-break:break-all;">${link}</small><br><small>Doctor PIN: ${data.doctorPin} | Reception: ${data.receptionPin}</small><button class="btn btn-secondary" style="margin-top:8px;" onclick="deleteClinic('${c.key}')">Delete</button></div>`; }); document.getElementById("clinicList").innerHTML=html; }
async function deleteClinic(id){ if(confirm("Delete this clinic?")){ await db.ref(`clinics/${id}`).remove(); showToast("Clinic deleted"); loadAllClinics(); } }
// PIN handling
function startPin(role){ pinMode=role; pinBuffer=""; showPinPad(); }
function showPinPad(){ let html=`<div class="header"><div class="back-btn" onclick="document.getElementById('pinModal').remove()">←</div><div><h2>Enter PIN</h2><p>${pinMode} access</p></div></div><div class="container"><div class="card"><div class="pin-dots" id="pinDots"></div><div class="pin-grid" id="pinGrid"></div><div id="pinError" style="color:var(--danger);text-align:center;margin-top:16px;"></div></div></div>`; let modal=document.createElement("div"); modal.id="pinModal"; modal.className="screen active"; modal.style.position="fixed"; modal.style.inset="0"; modal.style.background="var(--bg-primary)"; modal.style.zIndex="2000"; modal.style.background="#F1F5F9"; modal.innerHTML=html; document.body.appendChild(modal); for(let i=1;i<=9;i++){ let btn=document.createElement("div"); btn.className="pin-key"; btn.innerText=i; btn.onclick=()=>addPinDigit(i.toString()); document.getElementById("pinGrid").appendChild(btn); } let zero=document.createElement("div"); zero.className="pin-key"; zero.innerText="0"; zero.onclick=()=>addPinDigit("0"); document.getElementById("pinGrid").appendChild(zero); let del=document.createElement("div"); del.className="pin-key"; del.innerHTML="⌫"; del.onclick=deletePinDigit; document.getElementById("pinGrid").appendChild(del); let cls=document.createElement("div"); cls.className="pin-key"; cls.innerHTML="C"; cls.onclick=clearPin; document.getElementById("pinGrid").appendChild(cls); function addPinDigit(d){ if(pinBuffer.length>=4) return; pinBuffer+=d; updatePinDots(); if(pinBuffer.length===4) verifyPin(); } function deletePinDigit(){ pinBuffer=pinBuffer.slice(0,-1); updatePinDots(); } function clearPin(){ pinBuffer=""; updatePinDots(); document.getElementById("pinError").innerText=""; } function updatePinDots(){ let dots=document.querySelectorAll("#pinDots .pin-dot"); if(!dots.length) for(let i=0;i<4;i++){ let d=document.createElement("div"); d.className="pin-dot"; document.getElementById("pinDots").appendChild(d); } dots=document.querySelectorAll("#pinDots .pin-dot"); dots.forEach((d,i)=>d.classList.toggle("filled",i<pinBuffer.length)); } async function verifyPin(){ let expected=null; if(pinMode==="admin") expected=ADMIN_PIN; else if(pinMode==="doctor") expected=clinicData?.doctorPin; else expected=clinicData?.receptionPin; if(pinBuffer===expected){ modal.remove(); if(pinMode==="doctor"){ goToScreen("doctorScreen"); loadDoctorQueue(); } else if(pinMode==="reception"){ goToScreen("receptionScreen"); loadReceptionQueue(); } else goToScreen("adminScreen"); } else { document.getElementById("pinError").innerText="Incorrect PIN"; pinBuffer=""; updatePinDots(); } } updatePinDots(); }
window.goBack=goBack; window.goToCheckin=goToCheckin; window.selectCheckinType=selectCheckinType; window.processCheckin=processCheckin; window.callNextPatient=callNextPatient; window.moveBackPatient=moveBackPatient; window.toggleEmergencyMode=toggleEmergencyMode; window.addDelay=addDelay; window.togglePause=togglePause; window.openBroadcastModal=openBroadcastModal; window.sendBroadcast=sendBroadcast; window.clearQueue=clearQueue; window.openAddPatientModal=openAddPatientModal; window.openVisitorModal=openVisitorModal; window.addVisitor=addVisitor; window.selectEmergency=selectEmergency; window.openSettingsModal=openSettingsModal; window.saveClinicSettings=saveClinicSettings; window.createClinic=createClinic; window.deleteClinic=deleteClinic; window.shareGiftCode=shareGiftCode; window.openReview=openReview; window.closeModal=closeModal; window.toggleSetLoy=toggleSetLoy; window.toggleNcLoy=toggleNcLoy; window.startPin=startPin;
init();
</script>
</body>
</html>
