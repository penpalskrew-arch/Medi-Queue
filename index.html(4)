async function loadDoctorQueue(){
  let snap=await db.ref(`queues/${clinicId}`).get();
  let patients=[], visitors=[];
  snap.forEach(c=>{ let p=c.val(); if(p.type==="visitor") visitors.push(p); else if(p.status!=="done") patients.push(p); });
  let current=patients.find(p=>p.status==="with-doctor");
  let waiting=patients.filter(p=>p.status==="waiting"||p.status==="next").sort((a,b)=>a.token-b.token);
  document.getElementById("docCurName").innerHTML=current?current.name:"—";
  document.getElementById("docCurMeta").innerHTML=current?`Token #${current.token} · ${current.type}`:"No patient";
  let queueHtml=waiting.map(p=>`<div class="queue-item ${p.emergency?'emergency':''}" onclick="selectPatientForAction('${p.key}')"><div class="token-badge ${p.type==='walkin'?'walkin':''}">${p.token}</div><div><strong>${p.name}</strong><div style="font-size:11px;">${p.type} · ${p.status}</div></div><div style="margin-left:auto;">${p.emergency?'🚨':''}</div></div>`).join("");
  document.getElementById("docQueueList").innerHTML=queueHtml||'<div class="empty-state">Queue empty</div>';
  let visitorHtml=visitors.map(v=>`<div class="queue-item visitor"><div class="token-badge">👔</div><div><strong>${v.name}</strong><div style="font-size:11px;">${v.purpose||"Visitor"}</div></div></div>`).join("");
  document.getElementById("visitorList").innerHTML=visitorHtml;
}
async function loadReceptionQueue(){
  let snap=await db.ref(`queues/${clinicId}`).get();
  let online=0,walkin=0,total=0,needAssist=0,patients=[];
  snap.forEach(c=>{ let p=c.val(); if(p.status!=="done" && p.type!=="visitor"){ total++; if(p.type==="online") online++; else walkin++; if(!p.phone) needAssist++; patients.push(p); } });
  document.getElementById("recOnline").innerHTML=online; document.getElementById("recWalkin").innerHTML=walkin;
  document.getElementById("recTotal").innerHTML=total; document.getElementById("recNeedAssist").innerHTML=needAssist;
  patients.sort((a,b)=>a.token-b.token);
  let html=patients.map(p=>`<div class="queue-item ${p.emergency?'emergency':''}" onclick="selectPatientForAction('${p.key}')"><div class="token-badge ${p.type==='walkin'?'walkin':''}">${p.token}</div><div><strong>${p.name}</strong><div style="font-size:11px;">${p.type} · ${p.status}</div></div><div style="margin-left:auto;"><i class="fab fa-whatsapp" onclick="event.stopPropagation();sendWhatsApp('${p.phone}','${p.token}')" style="color:#25D366;margin-right:8px;"></i>${p.emergency?'🚨':''}${!p.phone?'📵':''}</div></div>`).join("");
