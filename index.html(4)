    document.getElementById("loader").style.display = "none";
    let savedToken = localStorage.getItem(`token_${clinicId}`);
    if(savedToken) { currentPatient = { token: parseInt(savedToken) }; goToScreen("statusScreen"); loadPatientStatus(); }
    refreshHomePreview();
    startRealtimeUpdates();
  } catch(e) { document.getElementById("loaderMsg").innerText="Connection error"; setTimeout(()=>document.getElementById("loader").style.display="none",2000); }
}

async function refreshHomePreview() {
  if(!clinicId) return;
  let snap = await db.ref(`queues/${clinicId}`).get();
  let online=0, walkin=0, currentToken=null, todayCount=0, peakHourCount=0, peakHour="--:--";
  snap.forEach(c=>{ let p=c.val(); if(p.status!=="done"){ if(p.type==="online") online++; else walkin++; if(p.status==="with-doctor") currentToken=p.token; todayCount++; } });
  document.getElementById("previewOnline").innerHTML = online;
  document.getElementById("previewWalkin").innerHTML = walkin;
  document.getElementById("currentTokenDisplay").innerHTML = currentToken ? `#${currentToken}` : "—";
  document.getElementById("todayCount").innerHTML = todayCount;
  document.getElementById("queueTimestamp").innerHTML = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
}

function startRealtimeUpdates() { if(!clinicId) return; db.ref(`queues/${clinicId}`).on("value",()=>{ if(document.getElementById("homeScreen").classList.contains("active")) refreshHomePreview(); if(document.getElementById("doctorScreen").classList.contains("active")) loadDoctorQueue(); if(document.getElementById("receptionScreen").classList.contains("active")) loadReceptionQueue(); }); db.ref(`clinics/${clinicId}`).on("value",(s)=>{ if(s.exists()){ clinicData=s.val(); if(document.getElementById("doctorScreen").classList.contains("active")){ if(clinicData.delay) document.getElementById("docDelayBanner").style.display="block", document.getElementById("docDelayText").innerHTML=`⏰ Running ${clinicData.delay} min behind`; else document.getElementById("docDelayBanner").style.display="none"; } if(clinicData.globalAnnouncement) document.getElementById("globalAnnouncement").innerHTML=clinicData.globalAnnouncement, document.getElementById("globalAnnouncement").style.display="block"; } }); }

async function processCheckin() {
  let name = document.getElementById("checkinName").value.trim();
  let phone = document.getElementById("checkinPhone").value.trim();
  if(!name) { showToast("Please enter name"); return; }
  if(clinicData?.maxPatients>0){
    let snap=await db.ref(`queues/${clinicId}`).get(); let count=0; snap.forEach(()=>count++);
    if(count>=clinicData.maxPatients){ showToast("Clinic is full for today"); return; }
  }
  if(phone && phone.length>=8){
    let snap=await db.ref(`queues/${clinicId}`).get(); let existing=null;
    snap.forEach(c=>{ let p=c.val(); if(p.phone===phone && p.status!=="done") existing=p; });
    if(existing){ showToast(`You already have token #${existing.token}`); localStorage.setItem(`token_${clinicId}`,existing.token); currentPatient={token:existing.token}; goToScreen("statusScreen"); loadPatientStatus(); return; }
  }
  let btn = document.getElementById("checkinBtn");
  btn.disabled = true; btn.innerText = "Processing...";
  try {
    let counterRef = db.ref(`counters/${clinicId}`);
    let token; await counterRef.transaction(cur=>{ token=(cur||0)+1; return token; });
    let queueSnap = await db.ref(`queues/${clinicId}`).get();
    let hasDoctor=false; queueSnap.forEach(c=>{ if(c.val().status==="with-doctor") hasDoctor=true; });
    let status = !hasDoctor ? "next" : "waiting";
    await db.ref(`queues/${clinicId}`).push({ name, phone, token, type:selectedType, status, createdAt:Date.now(), visits:1 });
    localStorage.setItem(`token_${clinicId}`, token);
    currentPatient = { token, name };
    document.getElementById("statusName").innerHTML = name;
    document.getElementById("statusToken").innerHTML = `#${token}`;
    showToast(`Token #${token} assigned!`);
    if(!audioUnlocked && audioCtx) audioCtx.resume();
    goToScreen("statusScreen");
    loadPatientStatus();
    refreshHomePreview();
  } catch(e) { showToast("Error: "+e.message); }
  finally { btn.disabled=false; btn.innerText="Check In →"; }
}

function loadPatientStatus() {
  if(!currentPatient||!clinicId) return;
  db.ref(`queues/${clinicId}`).on("value",(snap)=>{
    let all=[]; snap.forEach(c=>all.push({...c.val(),key:c.key}));
    let myData=all.find(p=>p.token===currentPatient.token);
    if(!myData) return;
    let waiting=all.filter(p=>p.status==="waiting"||p.status==="next").sort((a,b)=>a.token-b.token);
    let pos=waiting.findIndex(p=>p.token===currentPatient.token)+1;
    if(myData.status==="with-doctor"){ document.getElementById("statusPosition").innerHTML="→"; document.getElementById("statusMessage").innerHTML="It's your turn! Please go in now."; playNotifySound(); }
    else if(myData.status==="done"){ document.getElementById("statusPosition").innerHTML="✓"; document.getElementById("statusMessage").innerHTML="Visit complete. Thank you!"; if(myData.note) document.getElementById("doctorNote").style.display="block", document.getElementById("doctorNoteText").innerHTML=myData.note; if(clinicData?.reviewLink) document.getElementById("reviewBtn").style.display="block"; localStorage.removeItem(`token_${clinicId}`); let visits=(myData.visits||1); if(clinicData?.loyaltyEnabled && visits%4===0) showLoyaltyReward(visits, myData.phone); }
    else if(pos===1){ document.getElementById("statusPosition").innerHTML="1st"; document.getElementById("statusMessage").innerHTML="You're next! Please be ready."; if(pos===2) playNotifySound(); }
    else { document.getElementById("statusPosition").innerHTML=`${pos}`; document.getElementById("statusMessage").innerHTML=`${pos-1} person(s) ahead`; if(pos===3) playNotifySound(); }
    if(clinicData?.delay) document.getElementById("statusDelay").style.display="block", document.getElementById("statusDelay").innerHTML=`⏰ Clinic is ${clinicData.delay} minutes behind`;
  });
}

