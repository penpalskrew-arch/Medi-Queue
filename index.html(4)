<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0A2B1A">
<title>FlowSync · Complete Clinic Queue System</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

:root {
  --primary: #0D9488;
  --primary-dark: #0F766E;
  --primary-light: #14B8A6;
  --primary-bg: rgba(13, 148, 136, 0.08);
  --secondary: #F59E0B;
  --secondary-bg: rgba(245, 158, 11, 0.08);
  --danger: #EF4444;
  --danger-bg: rgba(239, 68, 68, 0.08);
  --emergency: #DC2626;
  --info: #3B82F6;
  --info-bg: rgba(59, 130, 246, 0.08);
  --success: #10B981;
  --gold: #FBBF24;
  --bg-primary: #09090B;
  --bg-secondary: #18181B;
  --bg-tertiary: #27272A;
  --bg-card: #18181B;
  --text-primary: #FAFAFA;
  --text-secondary: #A1A1AA;
  --text-muted: #71717A;
  --border: #27272A;
  --border-light: #3F3F46;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --shadow-glow: 0 0 0 2px rgba(13, 148, 136, 0.3);
  --shadow-glow-danger: 0 0 0 2px rgba(220, 38, 38, 0.3);
}

[data-theme="light"] {
  --bg-primary: #F4F4F5;
  --bg-secondary: #FFFFFF;
  --bg-tertiary: #E4E4E7;
  --bg-card: #FFFFFF;
  --text-primary: #18181B;
  --text-secondary: #52525B;
  --text-muted: #71717A;
  --border: #E4E4E7;
  --border-light: #D4D4D8;
}

body {
  font-family: 'Inter', sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.5;
}

.screen { display: none; min-height: 100vh; flex-direction: column; }
.screen.active { display: flex; }

#loader {
  position: fixed; inset: 0; background: var(--bg-primary);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  z-index: 10000; gap: 20px;
}
.loader-spinner { width: 48px; height: 48px; border: 3px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.header {
  position: sticky; top: 0; z-index: 100; background: var(--bg-secondary);
  border-bottom: 1px solid var(--border); padding: 12px 16px;
  display: flex; align-items: center; gap: 12px;
}
.back-btn { width: 36px; height: 36px; border-radius: 50%; background: var(--bg-tertiary); display: flex; align-items: center; justify-content: center; cursor: pointer; }
.container { padding: 16px; flex: 1; max-width: 600px; margin: 0 auto; width: 100%; }
.card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 16px; }
.stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 20px; }
.stat-card { background: var(--bg-tertiary); border-radius: var(--radius-md); padding: 16px; text-align: center; cursor: pointer; transition: all 0.2s; }
.stat-card:active { transform: scale(0.98); }
.stat-value { font-size: 32px; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
.stat-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
.btn { padding: 12px 20px; border: none; border-radius: var(--radius-md); font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.15s; text-align: center; }
.btn-primary { background: var(--primary); color: white; }
.btn-primary:active { transform: scale(0.97); }
.btn-secondary { background: var(--bg-tertiary); color: var(--text-primary); border: 1px solid var(--border); }
.btn-danger { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger); }
.btn-warning { background: var(--secondary-bg); color: var(--secondary); border: 1px solid var(--secondary); }
.btn-emergency { background: var(--emergency); color: white; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.live-queue { background: var(--bg-tertiary); border-radius: var(--radius-lg); margin-bottom: 20px; overflow: hidden; }
.live-queue-header { padding: 16px; background: var(--primary-bg); display: flex; justify-content: space-between; align-items: center; }
.live-dot { width: 8px; height: 8px; background: var(--primary); border-radius: 50%; animation: pulse 1.5s infinite; display: inline-block; margin-right: 6px; }
@keyframes pulse { 0%,100%{opacity:1}50%{opacity:0.5} }
.current-token { padding: 20px; text-align: center; background: var(--bg-secondary); margin: 12px; border-radius: var(--radius-md); }
.current-token-value { font-size: 48px; font-weight: 700; font-family: monospace; color: var(--primary); }
.portal-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 16px; display: flex; align-items: center; gap: 14px; cursor: pointer; margin-bottom: 12px; transition: all 0.2s; }
.portal-card:active { transform: scale(0.98); border-color: var(--primary); }
.portal-icon { width: 52px; height: 52px; border-radius: var(--radius-md); background: var(--bg-tertiary); display: flex; align-items: center; justify-content: center; font-size: 24px; }
.type-selector { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
.type-option { padding: 16px; background: var(--bg-tertiary); border: 2px solid var(--border); border-radius: var(--radius-md); text-align: center; cursor: pointer; transition: all 0.2s; }
.type-option.selected { border-color: var(--primary); background: var(--primary-bg); }
.form-input, .form-textarea { width: 100%; padding: 12px 14px; background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--text-primary); font-family: inherit; font-size: 14px; }
.form-textarea { min-height: 80px; resize: vertical; }
.form-input:focus, .form-textarea:focus { outline: none; border-color: var(--primary); box-shadow: var(--shadow-glow); }
.toast { position: fixed; bottom: 80px; left: 16px; right: 16px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 12px 16px; text-align: center; z-index: 9999; opacity: 0; transform: translateY(20px); transition: all 0.3s; pointer-events: none; }
.toast.show { opacity: 1; transform: translateY(0); }
.modal { position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 1000; display: none; align-items: flex-end; backdrop-filter: blur(4px); }
.modal.open { display: flex; }
.modal-content { background: var(--bg-secondary); border-radius: var(--radius-xl) var(--radius-xl) 0 0; padding: 24px; width: 100%; max-width: 500px; margin: 0 auto; max-height: 80vh; overflow-y: auto; }
.queue-item { background: var(--bg-tertiary); border-radius: var(--radius-md); padding: 14px; display: flex; align-items: center; gap: 12px; margin-bottom: 8px; cursor: pointer; transition: all 0.2s; border-left: 3px solid transparent; }
.queue-item:active { transform: scale(0.98); }
.queue-item.emergency { border-left-color: var(--emergency); background: var(--danger-bg); }
.queue-item.visitor { border-left-color: var(--info); background: var(--info-bg); }
.token-badge { width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--primary-bg); display: flex; align-items: center; justify-content: center; font-weight: bold; font-family: monospace; font-size: 18px; }
.token-badge.walkin { background: var(--secondary-bg); color: var(--secondary); }
.token-badge.emergency-badge { background: var(--emergency); color: white; }
.pin-dots { display: flex; justify-content: center; gap: 16px; margin: 24px 0; }
.pin-dot { width: 16px; height: 16px; border-radius: 50%; background: var(--bg-tertiary); border: 2px solid var(--border); transition: all 0.2s; }
.pin-dot.filled { background: var(--primary); border-color: var(--primary); }
.pin-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 20px; }
.pin-key { padding: 18px; background: var(--bg-tertiary); border-radius: var(--radius-md); text-align: center; font-size: 24px; font-weight: 600; cursor: pointer; transition: all 0.1s; }
.pin-key:active { transform: scale(0.95); background: var(--primary-bg); }
.badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 20px; font-size: 10px; font-weight: 600; }
.badge-emergency { background: var(--emergency); color: white; }
.badge-visitor { background: var(--info); color: white; }
.badge-gift { background: var(--gold); color: #000; }
.empty-state { text-align: center; padding: 40px; color: var(--text-muted); }
.toggle-switch { width: 46px; height: 26px; background: var(--bg-tertiary); border-radius: 13px; position: relative; cursor: pointer; border: 1px solid var(--border); }
.toggle-switch.active { background: var(--primary); }
.toggle-knob { width: 22px; height: 22px; background: white; border-radius: 50%; position: absolute; top: 1px; left: 2px; transition: left 0.2s; }
.toggle-switch.active .toggle-knob { left: 22px; }
</style>
</head>
<body>

<div id="loader"><div class="loader-spinner"></div><div style="font-size:18px;font-weight:600;">FlowSync</div><div id="loaderMsg" style="font-size:13px;color:var(--text-muted);">Initializing clinic...</div></div>
<div id="toast" class="toast"></div>

<!-- HOME SCREEN -->
<div id="homeScreen" class="screen active">
  <div class="container">
    <div style="text-align:center; margin-bottom:24px;"><div style="font-size:48px;">⚡</div><h1 style="font-size:28px;">FlowSync</h1><p id="homeClinicName" style="font-size:13px;color:var(--text-muted);"></p><div id="clinicHoursDisplay" style="font-size:11px;color:var(--text-muted);margin-top:6px;"></div></div>
    <div class="live-queue">
      <div class="live-queue-header"><span><span class="live-dot"></span> Live Queue</span><span id="queueTimestamp" style="font-size:12px;"></span></div>
      <div class="current-token"><div class="current-token-label">Now with Doctor</div><div class="current-token-value" id="currentTokenDisplay">—</div></div>
      <div class="stats-grid"><div class="stat-card"><div class="stat-value" id="previewOnline" style="color:var(--primary);">0</div><div class="stat-label">🌐 Online</div></div><div class="stat-card"><div class="stat-value" id="previewWalkin" style="color:var(--secondary);">0</div><div class="stat-label">🚶 Walk-in</div></div></div>
      <div class="stats-grid" style="margin:0 12px 12px;"><div class="stat-card"><div class="stat-value" id="todayCount">0</div><div class="stat-label">Today's Patients</div></div><div class="stat-card"><div class="stat-value" id="peakHour">--:--</div><div class="stat-label">Peak Hour</div></div></div>
    </div>
    <div class="portal-card" onclick="goToCheckin()"><div class="portal-icon">🙋</div><div class="portal-info"><h3>Check In</h3><p>Join the queue online or as walk-in</p></div><div style="margin-left:auto;">→</div></div>
    <div class="portal-card" onclick="startPin('doctor')"><div class="portal-icon">🩺</div><div class="portal-info"><h3>Doctor Portal</h3><p>PIN protected · Manage consultations</p></div><div style="margin-left:auto;">→</div></div>
    <div class="portal-card" onclick="startPin('reception')"><div class="portal-icon">📋</div><div class="portal-info"><h3>Reception Desk</h3><p>Full queue control & patient management</p></div><div style="margin-left:auto;">→</div></div>
    <div id="adminPortal" class="portal-card" style="display:none;" onclick="startPin('admin')"><div class="portal-icon">⚙️</div><div class="portal-info"><h3>Admin Panel</h3><p>Create and manage clinics</p></div><div style="margin-left:auto;">→</div></div>
  </div>
</div>

<!-- CHECKIN SCREEN -->
<div id="checkinScreen" class="screen">
  <div class="header"><div class="back-btn" onclick="goBack()">←</div><div class="header-title"><h1>Check In</h1><p>Join the queue</p></div></div>
  <div class="container">
    <div class="card">
      <div class="type-selector"><div class="type-option" id="onlineTypeOpt" onclick="selectCheckinType('online')"><i>🌐</i><div>Online</div><div style="font-size:10px;color:var(--text-muted);">Join from home</div></div><div class="type-option" id="walkinTypeOpt" onclick="selectCheckinType('walkin')"><i>🚶</i><div>Walk-in</div><div style="font-size:10px;color:var(--text-muted);">At clinic now</div></div></div>
      <div class="form-group"><label class="form-label" style="font-size:12px;color:var(--text-muted);">Full Name</label><input type="text" class="form-input" id="checkinName" placeholder="Enter patient name"></div>
      <div class="form-group"><label class="form-label" style="font-size:12px;color:var(--text-muted);">Mobile Number</label><input type="tel" class="form-input" id="checkinPhone" placeholder="10-digit number"></div>
      <div class="ban ban-info" style="background:var(--info-bg);border:1px solid var(--info);border-radius:var(--radius-md);padding:12px;margin-bottom:16px;font-size:12px;">ℹ️ If you miss your turn, you'll be moved 3 positions back. Please stay near the clinic when your token is approaching.</div>
      <button class="btn btn-primary" style="width:100%;" id="checkinBtn" onclick="processCheckin()">Check In →</button>
    </div>
  </div>
</div>

<!-- PATIENT STATUS SCREEN -->
<div id="statusScreen" class="screen">
  <div class="header"><div class="back-btn" onclick="goBack()">←</div><div class="header-title"><h1 id="statusName">Your Status</h1><p><span class="live-dot"></span> Live updates</p></div></div>
  <div class="container">
    <div id="globalAnnouncement" style="background:var(--secondary-bg);border:1px solid var(--secondary);border-radius:var(--radius-md);padding:12px;margin-bottom:16px;display:none;"></div>
    <div class="card" style="text-align:center;">
      <div><div class="token-value" id="statusToken" style="font-size:64px;font-weight:700;font-family:monospace;">#---</div><div class="token-label" style="font-size:12px;color:var(--text-muted);">Your Token</div></div>
      <div id="statusPosition" style="font-size:36px;font-weight:700;margin:16px 0;">—</div>
      <div id="statusMessage" style="color:var(--text-muted);">Waiting in queue...</div>
      <div id="statusDelay" style="font-size:12px;color:var(--secondary);margin-top:12px;display:none;"></div>
    </div>
    <div id="doctorNote" class="card" style="display:none;"><div class="form-label">Doctor's Note</div><div id="doctorNoteText" style="font-size:14px;line-height:1.5;"></div></div>
    <div id="loyaltyCard" class="card" style="display:none;text-align:center;"><div class="stats-grid"><div class="stat-card"><div class="stat-value" id="stampCount">0</div><div class="stat-label">Stamps</div></div><div class="stat-card"><div class="stat-value" id="nextReward">4</div><div class="stat-label">Next Reward</div></div></div><div id="giftCodeBox" style="background:var(--gold-bg);border-radius:var(--radius-md);padding:12px;margin-top:12px;display:none;"><div style="font-size:12px;">🎁 Gift Code for Friend</div><div id="giftCode" style="font-family:monospace;font-size:18px;font-weight:700;color:var(--gold);"></div><button class="btn btn-secondary" style="margin-top:8px;" onclick="shareGiftCode()">📤 Share on WhatsApp</button></div></div>
    <div id="reviewBtn" class="btn btn-primary" style="display:none;" onclick="openReview()">⭐ How was your visit?</div>
  </div>
</div>

<!-- DOCTOR PORTAL -->
<div id="doctorScreen" class="screen">
  <div class="header"><div class="back-btn" onclick="goBack()">←</div><div class="header-title"><h1>Doctor Portal</h1><p><span class="live-dot"></span> Live control</p></div><div><button class="btn btn-secondary" style="padding:6px 12px;width:auto;" onclick="openSettingsModal()">⚙️</button></div></div>
  <div class="container">
    <div id="docDelayBanner" class="card" style="background:var(--secondary-bg);display:none;"><div id="docDelayText"></div></div>
    <div class="card"><div class="form-label">Now with you</div><div id="docCurName" style="font-size:20px;font-weight:600;">—</div><div id="docCurMeta" style="font-size:13px;color:var(--text-muted);margin-top:4px;"></div><div id="docCurBadges" style="margin-top:8px;display:flex;gap:6px;"></div><textarea id="docNote" class="form-textarea" placeholder="Add prescription/notes for patient (appears after visit)" style="margin-top:12px;"></textarea><div class="grid-2" style="margin-top:12px;"><button class="btn btn-primary" onclick="callNextPatient()">✓ Room ready</button><button class="btn btn-danger" onclick="moveBackPatient()">⏪ Move back (No-show)</button><button class="btn btn-emergency" id="emergencyToggle" onclick="toggleEmergencyMode()">🚨 Emergency Mode</button></div></div>
    <div class="card"><div class="form-label">Queue Controls</div><div class="grid-3"><button class="btn btn-secondary" onclick="addDelay(5)">+5 min</button><button class="btn btn-secondary" onclick="addDelay(10)">+10 min</button><button class="btn btn-secondary" onclick="addDelay(15)">+15 min</button></div><div class="grid-2" style="margin-top:8px;"><button class="btn btn-warning" onclick="togglePause()">⏸ Pause Queue</button><button class="btn btn-secondary" onclick="openBroadcastModal()">📢 Broadcast</button><button class="btn btn-info" onclick="launchTVView()">📺 TV View</button><button class="btn btn-danger" onclick="clearQueue()">🗑 Clear Queue</button></div></div>
    <div class="form-label" style="margin-bottom:8px;">Queue / Visitors</div>
    <div id="docQueueList" class="queue-list"></div>
    <div id="visitorList" class="queue-list" style="margin-top:16px;"></div>
  </div>
</div>

<!-- RECEPTION PORTAL -->
<div id="receptionScreen" class="screen">
  <div class="header"><div class="back-btn" onclick="goBack()">←</div><div class="header-title"><h1>Reception Desk</h1><p><span class="live-dot"></span> Master view</p></div><div><button class="btn btn-secondary" style="padding:6px 12px;width:auto;" onclick="openSettingsModal()">⚙️</button></div></div>
  <div class="container">
    <div class="stats-grid"><div class="stat-card"><div class="stat-value" id="recOnline">0</div><div class="stat-label">🌐 Online</div></div><div class="stat-card"><div class="stat-value" id="recWalkin">0</div><div class="stat-label">🚶 Walk-in</div></div><div class="stat-card"><div class="stat-value" id="recTotal">0</div><div class="stat-label">Total</div></div><div class="stat-card"><div class="stat-value" id="recNeedAssist">0</div><div class="stat-label">Need Assist</div></div></div>
    <div class="card"><div class="grid-2"><button class="btn btn-primary" onclick="callNextPatient()">✓ Call next</button><button class="btn btn-warning" onclick="openAddPatientModal()">＋ Add walk-in</button><button class="btn btn-info" onclick="openVisitorModal()">👔 Add Visitor (Pharma/Rep)</button><button class="btn btn-secondary" onclick="openBroadcastModal()">📢 Broadcast</button></div></div>
    <div class="form-label" style="margin-bottom:8px;">Active Queue <span style="font-size:11px;">(tap to call/emergency)</span></div>
    <div id="recQueueList" class="queue-list"></div>
  </div>
</div>

<!-- ADMIN SCREEN -->
<div id="adminScreen" class="screen">
  <div class="header"><div class="back-btn" onclick="goBack()">←</div><div class="header-title"><h1>Admin Panel</h1><p>Manage clinics</p></div></div>
  <div class="container">
    <div class="card"><div class="form-label">Create New Clinic</div><input class="form-input" id="ncName" placeholder="Clinic name"><div class="grid-2"><input class="form-input" id="ncDpin" placeholder="Doctor PIN (4 digits)" maxlength="4"><input class="form-input" id="ncRpin" placeholder="Reception PIN (4 digits)" maxlength="4"></div><input class="form-input" id="ncReview" placeholder="Google Review link"><div class="grid-2"><input class="form-input" id="ncStart" type="time" placeholder="Start time"><input class="form-input" id="ncStop" type="time" placeholder="Stop time"></div><input class="form-input" id="ncMax" type="number" placeholder="Max patients per day (0=unlimited)" value="0"><div class="grid-2"><div><div>Loyalty Stamps</div><div style="font-size:11px;color:var(--text-muted);">4 visits = gift</div></div><div class="toggle-switch" id="ncLoyToggle" onclick="toggleNcLoy()"><div class="toggle-knob"></div></div></div><div id="ncLoyRow" style="display:none;"><input class="form-input" id="ncReward" placeholder="Reward description (e.g., Free consultation)"></div><button class="btn btn-primary" id="ncBtn" onclick="createClinic()">Generate clinic link →</button></div>
    <div class="form-label">All Clinics</div><div id="clinicList"></div>
  </div>
</div>

<!-- MODALS -->
<div id="broadcastModal" class="modal" onclick="if(event.target===this)closeModal('broadcastModal')"><div class="modal-content"><h3>Broadcast Message</h3><p style="font-size:12px;color:var(--text-muted);margin-bottom:16px;">Message appears on all patient screens</p><textarea id="broadcastMsg" class="form-textarea" rows="3" placeholder="e.g., Doctor is in a meeting. Please wait patiently."></textarea><div class="grid-2"><button class="btn btn-primary" onclick="sendBroadcast()">Send</button><button class="btn btn-secondary" onclick="closeModal('broadcastModal')">Cancel</button></div></div></div>
<div id="visitorModal" class="modal" onclick="if(event.target===this)closeModal('visitorModal')"><div class="modal-content"><h3>Add Visitor</h3><input class="form-input" id="visitorName" placeholder="Visitor/Company name"><input class="form-input" id="visitorPurpose" placeholder="Purpose (e.g., Pharma Rep, Meeting)"><div class="grid-2"><button class="btn btn-primary" onclick="addVisitor()">Add</button><button class="btn btn-secondary" onclick="closeModal('visitorModal')">Cancel</button></div></div></div>
<div id="settingsModal" class="modal" onclick="if(event.target===this)closeModal('settingsModal')"><div class="modal-content"><h3>Clinic Settings</h3><div class="grid-2"><input class="form-input" id="setStart" type="time" placeholder="Start time"><input class="form-input" id="setStop" type="time" placeholder="Stop time"></div><input class="form-input" id="setMax" type="number" placeholder="Max patients per day"><input class="form-input" id="setGrace" type="number" placeholder="Grace period (minutes)" value="10"><div class="grid-2"><div><div>Loyalty Enabled</div><div style="font-size:11px;">4 stamps = gift</div></div><div class="toggle-switch" id="setLoyToggle" onclick="toggleSetLoy()"><div class="toggle-knob"></div></div></div><div id="setLoyRow" style="display:none;"><input class="form-input" id="setReward" placeholder="Reward description"></div><button class="btn btn-primary" onclick="saveClinicSettings()">Save Settings</button></div></div>

<script>
// Firebase Config
const firebaseConfig = {
