async function callNextPatient() {
  if(!clinicId) return;
  let queueRef=db.ref(`queues/${clinicId}`);
  await queueRef.transaction(data=>{
    if(!data) return;
    let entries=Object.entries(data).map(([k,v])=>({...v,key:k}));
    let current=entries.find(e=>e.status==="with-doctor");
    if(current) data[current.key].status="done";
    let waiting=entries.filter(e=>e.status==="waiting"||e.status==="next").sort((a,b)=>a.token-b.token);
    if(waiting[0]) data[waiting[0].key].status="with-doctor";
    return data;
  });
  showToast("Next patient called");
}

async function moveBackPatient() {
  if(!clinicId) return;
  let snap=await db.ref(`queues/${clinicId}`).get();
  let current=null, currentKey=null;
  snap.forEach(c=>{ if(c.val().status==="with-doctor"){ current=c.val(); currentKey=c.key; } });
  if(currentKey){
    let waiting=[]; snap.forEach(c=>{ let p=c.val(); if(p.status==="waiting" && p.key!==currentKey) waiting.push({...p,key:c.key}); });
    waiting.sort((a,b)=>a.token-b.token);
    let pos3 = waiting[2] || waiting[waiting.length-1];
    if(pos3){
      let newToken = pos3.token + 0.5;
      await db.ref(`queues/${clinicId}/${currentKey}`).update({ status:"waiting", token:newToken, wasSkipped:true });
      showToast(`${current.name} moved 3 positions back`);
    } else showToast("Not enough patients to move back");
  } else showToast("No active patient");
}

