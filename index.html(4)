function showPinPad(){ let html=`<div class="header"><div class="back-btn" onclick="document.querySelector('#pinModal').remove()">←</div><div class="header-title"><h1>Enter PIN</h1><p>${pinMode} access</p></div></div><div class="container"><div class="card"><div class="pin-dots" id="pinDots"></div><div class="pin-grid" id="pinGrid"></div><div id="pinError" style="color:var(--danger);text-align:center;margin-top:16px;"></div></div></div>`; let modal=document.createElement("div"); modal.id="pinModal"; modal.className="screen active"; modal.style.position="fixed"; modal.style.inset="0"; modal.style.background="var(--bg-primary)"; modal.style.zIndex="2000"; modal.innerHTML=html; document.body.appendChild(modal); for(let i=1;i<=9;i++){ let btn=document.createElement("div"); btn.className="pin-key"; btn.innerText=i; btn.onclick=()=>addPinDigit(i.toString()); document.getElementById("pinGrid").appendChild(btn); } let zero=document.createElement("div"); zero.className="pin-key"; zero.innerText="0"; zero.onclick=()=>addPinDigit("0"); document.getElementById("pinGrid").appendChild(zero); let del=document.createElement("div"); del.className="pin-key"; del.innerHTML="⌫"; del.onclick=deletePinDigit; document.getElementById("pinGrid").appendChild(del); let cls=document.createElement("div"); cls.className="pin-key"; cls.innerHTML="C"; cls.onclick=clearPin; document.getElementById("pinGrid").appendChild(cls); function addPinDigit(d){ if(pinBuffer.length>=4) return; pinBuffer+=d; updatePinDots(); if(pinBuffer.length===4) verifyPin(); } function deletePinDigit(){ pinBuffer=pinBuffer.slice(0,-1); updatePinDots(); } function clearPin(){ pinBuffer=""; updatePinDots(); document.getElementById("pinError").innerText=""; } function updatePinDots(){ let dots=document.querySelectorAll("#pinDots .pin-dot"); if(!dots.length) for(let i=0;i<4;i++){ let d=document.createElement("div"); d.className="pin-dot"; document.getElementById("pinDots").appendChild(d); } dots=document.querySelectorAll("#pinDots .pin-dot"); dots.forEach((d,i)=>d.classList.toggle("filled",i<pinBuffer.length)); } async function verifyPin(){ let expected=null; if(pinMode==="admin") expected=ADMIN_PIN; else if(pinMode==="doctor") expected=clinicData?.doctorPin; else expected=clinicData?.receptionPin; if(pinBuffer===expected){ modal.remove(); if(pinMode==="doctor"){ goToScreen("doctorScreen"); loadDoctorQueue(); } else if(pinMode==="reception"){ goToScreen("receptionScreen"); loadReceptionQueue(); } else goToScreen("adminScreen"); } else { document.getElementById("pinError").innerText="Incorrect PIN"; pinBuffer=""; updatePinDots(); } } updatePinDots(); }

